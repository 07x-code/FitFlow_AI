FITFLOW_LLM_PROVIDER=siliconflow
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen3.5-4B
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=
OPENAI_API_KEY=
FITFLOW_WORKING_MEMORY_BACKEND=redis
FITFLOW_REDIS_URL=redis://127.0.0.1:6379/0
FITFLOW_WORKING_MEMORY_TTL_SECONDS=7200
FITFLOW_WORKING_MEMORY_CAPACITY=40
FITFLOW_SESSION_BACKEND=redis
FITFLOW_SESSION_TTL_SECONDS=604800
FITFLOW_SESSION_COOKIE_NAME=fitflow_session
FITFLOW_SESSION_COOKIE_SECURE=false
# PostgreSQL
FITFLOW_DATABASE_URL=postgresql+asyncpg://fitflow:fitflow@127.0.0.1:5432/fitflow_dev
FITFLOW_TEST_DATABASE_URL=postgresql+asyncpg://fitflow:fitflow@127.0.0.1:5432/fitflow_test
FITFLOW_DEMO_DATABASE_URL=postgresql+asyncpg://fitflow:fitflow@127.0.0.1:5432/fitflow_demo
